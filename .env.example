# DayDAG identity configuration
# ---------------------------------------------------------------------------
# This repository is public. No real identifier belongs in it.
#
# Every Slack id, Google file id, workspace id, email address and absolute path
# the agent needs lives in a local `.env`, which is gitignored. Docs and code
# refer to those values indirectly, as ${VAR_NAME}; src/daydag/config.py
# resolves them at runtime, and scripts/scan_secrets.py blocks a raw one from
# being committed.
#
#   cp .env.example .env     # then fill in the real values
#
# THE KEY NAMES ARE PART OF THE SECRET.
# `SLACK_USER_JANE_DOE=U000000000` leaks a colleague's name even though the id
# is a placeholder, and a key like SLACK_CH_PROJECT_<CODENAME> leaks an
# unannounced project. So keys are named for the ROLE or FUNCTION they serve,
# never for the person or codename behind them. Someone reading this file
# should learn how the agent is wired, not who works where or what is shipping.
#
# The keys below are illustrative, not exhaustive. Add whatever your own setup
# needs, following the same shape - and add it here too, because this file is
# the schema and CI checks that `.env` declares nothing undocumented.
# ---------------------------------------------------------------------------


# --- Slack: people ---------------------------------------------------------
# Always address people by id. Display-name lookups (`from:@someone`) fail
# silently in Slack search, which is worse than failing loudly.
# Shape: SLACK_USER_<ROLE>
SLACK_USER_PRINCIPAL=U000000000        # the person the agent works for
SLACK_USER_VP_DATA=U000000000          # a direct report, by role
SLACK_USER_VP_AI=U000000000
SLACK_USER_SPONSOR=U000000000          # who the weekly progress report goes to


# --- Slack: conversations --------------------------------------------------
# Channel ids drift as channels are renamed, so the id is canonical and the
# key describes what the channel is FOR.
# Shape: SLACK_CH_<FUNCTION> / SLACK_DM_<ROLE> / SLACK_GDM_<GROUPING>
SLACK_CH_TEAM_ENGINEERING=C000000000
SLACK_CH_LEADERSHIP=C000000000
SLACK_CH_PRODUCT_POD=C000000000        # not the project's codename
SLACK_DM_SPONSOR=D000000000
SLACK_GDM_LEADS_3=C000000000           # a group DM, described by size and role


# --- Google Workspace ------------------------------------------------------
# File and folder ids from the Drive URL. Note that a TRUNCATED id still leaks
# a usable prefix, so never abbreviate one in a doc - reference the key.
# Shape: GDOC_<PURPOSE> / GDRIVE_<PURPOSE>
GDOC_GOALS_PRIORITIES=00000000000000000000000000000000000000000000
GDOC_VP_EXPECTATIONS=00000000000000000000000000000000000000000000
GDOC_FEEDBACK_METHODOLOGY=00000000000000000000000000000000000000000000
GDRIVE_FEEDBACK_LOG_FOLDER=00000000000000000000000000000000000000000000


# --- Other services --------------------------------------------------------
# Shape: <SERVICE>_<THING>
NOTION_USER_VP_AI=00000000-0000-0000-0000-000000000000
ATLASSIAN_CLOUD_ID=00000000-0000-0000-0000-000000000000
DATABRICKS_WORKSPACE_ID=0000000000000000


# --- Email -----------------------------------------------------------------
# Internal addresses are personal data; keep them out of the tree entirely.
EMAIL_PRINCIPAL=first.last@example.com
EMAIL_VP_DATA=first.last@example.com
EMAIL_VP_AI=first.last@example.com
EMAIL_ENABLEMENT_LEAD=first.last@example.com


# --- Local paths -----------------------------------------------------------
# Absolute paths leak a username, so these are configured rather than hardcoded.
VAULT_ROOT=/path/to/Obsidian/YourVault
STATE_DIR=$HOME/.local/state/daydag      # event log - deliberately outside the vault
MIRROR_DIR=$HOME/.local/share/daydag/repos

# Principal timezone; every wall-clock boundary is local to this.
TIMEZONE=America/Los_Angeles


# --- Meeting prep pings (SPEC 3.2) -----------------------------------------
# Which meetings earn the one interrupt the system allows. Both are optional,
# and UNSET MEANS UNKNOWN rather than "everyone qualifies": with no org domain
# configured nobody is declared an outside party, because the opposite default
# fires the interrupt on every meeting on the calendar and gets it muted.
#
# Comma-separated. Match whatever your calendar puts in an attendee list -
# addresses on most, display names on some.
#
# NO INLINE COMMENTS ON THESE TWO. config.Identities takes everything after the
# `=` as the value, so a trailing `# note` becomes part of the domain list and
# then nothing matches it - which for ORG_EMAIL_DOMAIN means every attendee
# reads as external and every meeting fires the interrupt.

# One or more org domains: example.com,example.net
ORG_EMAIL_DOMAIN=example.com

# Attendees whose presence in the room qualifies a meeting for prep.
PREP_LEADERSHIP=first.last@example.com
