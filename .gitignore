.DS_Store
.env
config/*.local.*
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
*.pyc
.claude/worktrees/

# generated by scripts/build_docs.py; the docstrings are the source of truth
docs/api.md

# The event log holds the sensitive partition by design - personnel, comp, the
# meeting ledger - and lives at ~/.local/state/daydag/. It must never be in a
# PUBLIC repo, so the pattern is here as a backstop for a stray copy or a
# --log that was pointed at the working directory by accident.
*.db
*.db-wal
*.db-shm
